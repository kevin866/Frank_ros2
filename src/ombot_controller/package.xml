<?xml version="1.0"?>
<package format="3">
  <name>ombot_controller</name>
  <version>0.0.1</version>
  <description>Controller plugins (e.g., GravityCancel, Effort) for Ombot.</description>

  <maintainer email="you@example.com">Kevin Wang</maintainer>
  <license>Apache-2.0</license>
  <author>Kevin Wang</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build deps -->
  <build_depend>eigen3_cmake_module</build_depend>
  <!-- <build_depend>Eigen3</build_depend> -->
  <!-- <build_depend>eigen</build_depend> -->
  <depend>eigen</depend>


  <!-- Code deps -->
  <depend>pluginlib</depend>
  <depend>rcpputils</depend>
  <depend>controller_interface</depend>
  <depend>realtime_tools</depend>
  <depend>trajectory_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>kdl_parser</depend>
  <depend>ombot_msgs</depend>
  <depend>osqp_vendor</depend>
  <depend>tf2_ros</depend>


  <!-- <depend>hardware_interface</depend> -->

  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Exec deps -->
  <exec_depend>eigen3_cmake_module</exec_depend>
  <!-- <exec_depend>Eigen3</exec_depend> -->

  <export>
    <!-- <controller_interface plugin="${prefix}/ombot_controller.xml"/> -->
    <!-- <controller_interface plugin="${prefix}/share/ombot_controller/ombot_controller.xml"/> -->
    <controller_manager plugin="${prefix}/share/ombot_controller/ombot_controller.xml"/>
    <controller_interface plugin="${prefix}/share/ombot_controller/ombot_controller.xml"/>

    <build_type>ament_cmake</build_type>
  </export>
</package>
