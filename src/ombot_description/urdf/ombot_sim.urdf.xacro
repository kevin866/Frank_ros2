<?xml version="1.0"?>
<robot name="ombot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base geometry -->
  <xacro:include filename="$(find ombot_description)/urdf/base/mecanum_base.urdf.xacro"/>
  <xacro:mecanum_base prefix="" sep_x="0.40" sep_y="0.70" wheel_radius="0.05"/>

  <!-- Arm geometry -->
  <xacro:include filename="$(find ombot_description)/urdf/arm/ombot_arm_module.urdf.xacro"/>
  <xacro:ombot_arm_module parent="base_link" mount_xyz="0.145 0.0 0.1" mount_rpy="0 0 0" prefix=""/>

  <!-- BASE: mock hardware -->
  <ros2_control name="ombot_base" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ARM: mock hardware -->
  <ros2_control name="ombot_arm" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_6">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- GRIPPER: mock hardware -->
  <ros2_control name="ombot_gripper" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="gripper_joint">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- ZED 2 camera mounted to base_link -->
  <xacro:include filename="$(find ombot_description)/urdf/zed_macro.urdf.xacro"/>

  <xacro:zed_camera name="zed2" model="zed2">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:zed_camera>

  <joint name="zed2_camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed2_camera_link"/>
    <origin xyz="0.22 0.12 0.13" rpy="0 -0.05 ${-pi/2}"/>
  </joint>


</robot>